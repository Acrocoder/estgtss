PORT=4000
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=https://estgtss-api.onrender.com/api

DB_HOST=localhost
DB_PORT=3306
DB_NAME=campuscare
DB_USER=campuscare_app
DB_PASSWORD=replace-with-database-password

# Generate a unique value with at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Set these privately when bootstrapping the first administrator.
ADMIN_USERNAME=estgadministrator@gmail.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-chars
ADMIN_NAME=School Administrator
# If renaming an existing administrator login, set its old username once.
ADMIN_PREVIOUS_USERNAME=

# Optional first-run staff accounts. Use unique passwords and remove them after setup.
PATRON_USERNAME=estgpatron@gmail.com
PATRON_PASSWORD=
PATRON_NAME=School Patron
MATRON_USERNAME=estgmatron@gmail.com
MATRON_PASSWORD=
MATRON_NAME=School Matron

# Optional email alerts for new teacher, class monitor, and student account requests.
# Configure these privately on the API host. Do not commit SMTP credentials.
ADMIN_NOTIFICATION_EMAIL=estgadministrator@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional persistent directory for administrator-uploaded school news images/videos.
NEWS_MEDIA_DIR=
